# Sample environment for the agent.
#
# Copy to .env and fill in. The Makefile / docker-compose read this file.

# Local LLM
PREFER_LOCAL=1
LOCAL_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Hosted fallback
HOSTED_PROVIDER=anthropic      # or openai
HOSTED_MODEL=claude-sonnet-4-20250514

# Get these from your provider's console.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent / HomeKit / Camera ports
LLM_PORT=8000
HOMEKIT_PORT=51827
VOICE_PORT=8765
CAMERAS_PORT=8001
DASHBOARD_PORT=3000

# Default HomePod room (overridden per-request via /tts payload)
HOMEPOD_ROOM=Bedroom

# Logging
LOG_LEVEL=info

# State directory
HOME_POD_AGENT_STATE_DIR=~/.homepod-agent